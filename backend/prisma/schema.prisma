generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model Menu {
  menuId       Int     @id @default(autoincrement()) @db.UnsignedInt
  name         String  @db.VarChar(180)
  price        Decimal @db.Decimal(10, 2)
  isBestSeller Boolean @default(false)
  typeId       Int     @db.UnsignedInt
  type         Type    @relation(fields: [typeId], references: [typeId], map: "fk_menus_type")
  ratings      Rating[]

  @@index([typeId], map: "idx_menus_typeId")
  @@map("menus")
}

model Type {
  typeId Int     @id @default(autoincrement()) @db.UnsignedInt
  name   String  @unique(map: "name") @db.VarChar(120)
  menus  Menu[]

  @@map("types")
}

model User {
  userId       Int      @id @default(autoincrement()) @db.UnsignedInt
  name         String   @db.VarChar(120)
  email        String   @unique(map: "email") @db.VarChar(190)
  passwordHash String   @db.VarChar(255)
  role         String   @default("USER") @db.VarChar(20)
  ratings      Rating[]

  @@map("users")
}

model Rating {
  ratingId Int  @id @default(autoincrement()) @db.UnsignedInt
  userId   Int  @db.UnsignedInt
  menuId   Int  @db.UnsignedInt
  score    Int  @db.UnsignedTinyInt
  user     User @relation(fields: [userId], references: [userId], onDelete: Cascade)
  menu     Menu @relation(fields: [menuId], references: [menuId], onDelete: Cascade)

  @@unique([userId, menuId], map: "user_menu_rating")
  @@index([menuId], map: "idx_ratings_menuId")
  @@map("ratings")
}
